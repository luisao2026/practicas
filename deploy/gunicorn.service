# /etc/systemd/system/practicas.service
[Unit]
Description=Sistema de Prácticas Preprofesionales ISTAM (Gunicorn)
After=network.target postgresql.service

[Service]
User=practicas
Group=www-data
WorkingDirectory=/home/practicas/practicas_istam
ExecStart=/home/practicas/practicas_istam/venv/bin/gunicorn config.wsgi:application \
          --workers 3 --timeout 120 --bind unix:/run/practicas/gunicorn.sock \
          --access-logfile - --error-logfile -
RuntimeDirectory=practicas
Restart=always

[Install]
WantedBy=multi-user.target
