# Copie este archivo en el servidor como /home/practicas/practicas_istam/.env
DEBUG=False
SECRET_KEY=PEGUE_AQUI_UNA_CLAVE_LARGA_Y_ALEATORIA
ALLOWED_HOSTS=practicas.su-dominio.edu.ec,IP_DEL_SERVIDOR
CSRF_TRUSTED_ORIGINS=https://practicas.su-dominio.edu.ec
# Ponga False solo mientras no tenga HTTPS (certificado SSL)
USAR_HTTPS=True

# Base de datos PostgreSQL
DB_ENGINE=postgres
DB_NAME=practicas_istam
DB_USER=practicas
DB_PASSWORD=CONTRASEÑA_DE_LA_BASE
DB_HOST=127.0.0.1
DB_PORT=5432

# Archivos subidos protegidos, entregados por Nginx
MEDIA_X_ACCEL=True

# Correo (Gmail con contraseña de aplicación)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=practicas@istam.edu.ec
EMAIL_HOST_PASSWORD=CONTRASEÑA_DE_APLICACION
DEFAULT_FROM_EMAIL=Prácticas ISTAM <practicas@istam.edu.ec>

INSTITUCION_NOMBRE=INSTITUTO SUPERIOR TECNOLÓGICO “AMAZÓNICO”
INSTITUCION_CIUDAD=Yantzaza
INSTITUCION_UBICACION=Yantzaza – Zamora Chinchipe – Ecuador
