# Copie este archivo como .env en la carpeta del proyecto en el servidor:  cp deploy/env.docker.example .env
DEBUG=False
SECRET_KEY=PEGUE_AQUI_UNA_CLAVE_LARGA_Y_ALEATORIA
ALLOWED_HOSTS=practicaspre.istam.edu.ec,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://practicaspre.istam.edu.ec
USAR_HTTPS=True

# Puerto interno donde escucha el sistema (Apache lo publica). Cámbielo si 8081 ya está ocupado.
PUERTO=8081

# Base de datos PostgreSQL (contenedor practicas_db)
DB_NAME=practicas_istam
DB_USER=practicas
DB_PASSWORD=CAMBIE_ESTA_CLAVE_DE_BASE_DE_DATOS

# Correo
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=practicas@istam.edu.ec
EMAIL_HOST_PASSWORD=CONTRASEÑA_DE_APLICACION
DEFAULT_FROM_EMAIL=Prácticas ISTAM <practicas@istam.edu.ec>

INSTITUCION_NOMBRE=INSTITUTO SUPERIOR TECNOLÓGICO “AMAZÓNICO”
INSTITUCION_CIUDAD=Yantzaza
INSTITUCION_UBICACION=Yantzaza – Zamora Chinchipe – Ecuador
