# Copie este archivo como .env y ajuste los valores
SECRET_KEY=cambie-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (vacío = SQLite). Para MySQL/XAMPP:
