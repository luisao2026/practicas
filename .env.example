# EMAIL_HOST_USER=sucorreo@gmail.com
# EMAIL_HOST_PASSWORD=contraseña_de_aplicacion_de_16_letras

INSTITUCION_NOMBRE=INSTITUTO SUPERIOR TECNOLÓGICO “AMAZÓNICO”
